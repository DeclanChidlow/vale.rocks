[
	...(post_data.ori → Tree.values)

	...(photography_data.ori → Tree.values)

	...((<https://vale.rocks/external/elsewhere.json>) → (_) => Tree.map(_, {
		value: (elsewhere) => {
			...elsewhere
			type: "elsewhere"
		}
	}) → Tree.values)

	...(demo_data.yaml → (_) => Tree.map(_, {
		value: (demo) => {
			...demo
			type: "demo"
		}
	}) → Tree.values)

	...(sign-up_data.yaml → (_) => Tree.map(_, {
		value: (signUp) => {
			...signUp
			type: "sign-up"
		}
	}) → Tree.values)

	...(event_data.yaml → functions/expand-events.js → Tree.values)

	...(video_data.ori → Tree.values)

	...(pulse_data.ori → Tree.values)

	...(micro_data.ori → Tree.values)

	...(now_data.ori → (_) => Tree.map(_, {
		value: (now) => {
			...now
			pub_time: now.date_raw
			type: "now-update"
		}
	}) → Tree.values)
]
→ (_) => Tree.sort(_, (item) => item.pub_time)
→ Tree.reverse
