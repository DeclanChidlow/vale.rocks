(paginated_elsewhere) => main_template.ori({
	title: "Elsewhere"
	description: "Vale's writings, contributions, and appearances published externally to Vale.Rocks. Read tech journalism, web development insights, digital culture analysis, and more from Declan Chidlow."
	og_description: "My writings, contributions, and appearances external to Vale.Rocks."
	stylesheet: "pages/elsewhere.css"
	canonical: `/elsewhere${ paginated_elsewhere.pageNumber > 1 ? '/' + paginated_elsewhere.pageNumber : '' }`

	_body: `
		<h1 class="section" data-pagefind-ignore>Elsewhere</h1>

		<div class="readable" data-pagefind-ignore>
			${ paginated_elsewhere.previousPage ? '' : `<p>Writings, contributions, and appearances external to this website that I have been directly involved with.</p>` }

			<ol id="posts">
				${ Tree.map(paginated_elsewhere.items, (item, key) => `
					<li class="elsewhere">
						<div>
							<h2><a href="https://${ item.url }">${ item.title }</a></h2>
							<p><time datetime="${ item.pub_time }" title="Date of publication." data-timezone-ignore>${ functions/pretty-date.js(item.pub_time) }</time>${ item.format ? ` | ${ item.format }` : '' } | ${ item.contribution }${ item.location ? ` | ${ item.location }` : '' }</p>
							${ item.note ? `<p class="note">${ item.note }</p>` : '' }
						</div>
						${ item.image ? `<img src="https://${ item.image }" alt="">` : '' }
					</li>
				`)}
			</ol>

			${ pagination.ori(paginated_elsewhere, "/elsewhere") }
		</div>
	`
})
