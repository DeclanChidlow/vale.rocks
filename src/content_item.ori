(item, key) => item.type === 'post' ? `
	<article class="post">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Post</title><path d="M144-288v-384h384v384zm72-72h240v-240H216zm-72-384v-72h672v72zm456 144v-72h216v72zm0 156v-72h216v72zm0 156v-72h216v72zM144-144v-72h672v72z"/></svg>
				<h2><a href="/${ Origami.basename(key) }"><time datetime="${ item.pub_time }" title="Date of first publication.">${ functions/pretty-date.js(item.pub_time) } UTC</time></a></h2>
			</div>
		</header>

		<p>
			<strong>${ item.title }</strong>
			<br><br>
			<em>${ item.og_description }</em>
			<br><br>
			${ item.description }
			<br><br>
			<a href="/${ Origami.basename(key) }">https://vale.rocks/${ Origami.basename(key) }</a>
		</p>
	</article>
`
: item.type === 'photo' ? `
	<article class="photo">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Photo</title><path d="M480-264q72 0 120-49t48-119q0-69-48-118t-120-50-120 50-48 118q0 70 48 119t120 49m0-72q-42 0-69-27t-27-68q0-40 27-68t69-29 69 29 27 68q0 41-27 68t-69 27M96-144v-576h192l72-96h240l72 96h192v576z"/></svg>
				<h2><a href="/${ Origami.basename(key) }"><time datetime="${ item.pub_time }" title="Date of first publication.">${ functions/pretty-date.js(item.pub_time) } UTC</time></a></h2>
			</div>

			<div class="socials">
				${ item.unsplash_link ? `<a href="${ item.unsplash_link }" title="Unsplash">${ (icons.yaml).unsplash }</a>` : '' }
			</div>
		</header>

		<p>${ item.description }</p>
		<img src="${ item.image }" alt="${ item.alt_text }" />
	</article>
`
: item.type === 'elsewhere' ? `
	<article class="elsewhere">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Elsewhere</title><path d="M144-144v-672h336v72H216v528h528v-264h72v336H144Zm243-192-51-51 357-357H576v-72h240v240h-72v-117L387-336Z"/></svg>
				<h2><a href="https://${ item.url }"><time datetime="${ item.pub_time }" title="Date of publication.">${ functions/pretty-date.js(item.pub_time) }  UTC</time></a></h2>
			</div>
		</header>
		
		<div class="readable">
			${ item.contribution === 'writer' ? `<p>Wrote <a href="https://${ item.url }">${ item.title }</a>${ item.location ? ` over on ${ item.location }` : '' }.</p>` : '' }
			${ item.contribution === 'contributor' ? `<p>Contributed to <a href="https://${ item.url }">${ item.title }</a>${ item.location ? ` on ${ item.location }` : '' }.</p>` : '' }
			${ item.contribution === 'guest' ? `<p>Appeared in <a href="https://${ item.url }">${ item.title }</a>${ item.location ? ` on ${ item.location }` : '' }.</p>` : '' }
			${ item.contribution === 'source' ? `<p>Provided source material for <a href="https://${ item.url }">${ item.title }</a>${ item.location ? ` on ${ item.location }` : '' }.</p>` : '' }
			${ item.note ? `<p>${ item.note }</p>` : '' }

			${ item.image ? `<img src="https://${ item.image }" alt="">` : '' }
		</div>
	</article>
`
: item.type === 'demo' ? `
	<article class="demo">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Demo</title><path d="M336-240 96-480l240-240 51 51-189 189 189 189zm288 0-51-51 189-189-189-189 51-51 240 240z"/></svg>
				<h2><a href="https://codepen.io/OuterVale/pen/${ item.codepen_slug }"><time datetime="${ item.pub_time }" title="Date of publication.">${ functions/pretty-date.js(item.pub_time) } UTC</time></a></h2>
			</div>

			<div class="socials">
				${ item.codepen_slug ? `<a href="https://codepen.io/OuterVale/pen/${ item.codepen_slug }" title="CodePen">${ (icons.yaml).codepen }</a>` : '' }
			</div>
		</header>

		<div class="readable">
			<strong>${ item.title }</strong>
			<img src="https://shots.codepen.io/username/pen/${ item.codepen_slug }-800.jpg" alt="">
		</div>
	</article>
`
: item.type === 'video' ? `
	<article class="video">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Video</title><path d="M336-216v-528l408 264z"/></svg>
				<h2><a href="/${ Origami.basename(key) }"><time datetime="${ item.pub_time }" title="Date of publication.">${ functions/pretty-date.js(item.pub_time) } UTC</time></a></h2>
			</div>

			<div class="socials">
				${ item.youtube_id ? `<a href="https://www.youtube.com/${ item.format === 'short' ? `shorts/` : `watch?v=` }${ item.youtube_id }" title="YouTube">${ item.format === 'short' ? `${ (icons.yaml).youtube_shorts }` : `${ (icons.yaml).youtube }` }</a>` : '' }
			</div>
		</header>
		
		<div class="readable">
			<p><strong>${ item.title }</strong><br><br>${ item.description }</p>

			<a href="/${ Origami.basename(key) }" aria-hidden="true">
				<img src="https://i.ytimg.com/vi/${ item.youtube_id }/${ item.format === 'short' ? `oar2.jpg` : `hq720.jpg` }" alt=""/>
			</a>
		</div>
	</article>
`
: item.type === 'pulse' ? `
	<article class="pulse">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Pulse</title><path d="M48-444v-72h221l93 232 236-585 142 353h172v72H692l-94-232L362-91 220-444z"/></svg>
				<h2><a href="/${ Origami.basename(key) }"><time datetime="${ item.pub_time }" title="Date of publication.">${ functions/pretty-date.js(item.pub_time) } UTC</time></a></h2>
			</div>
		</header>

		<div class="readable">
			<p><em>The annual recap of the year that was…</em></p>
			${ item/svg_year }
			<p><strong>${ item.title }</strong></p>
			<p>${ item.og_description }</p>
		</div>
	</article>
`
: item.type === 'now-update' ? `
	<article class="now-update">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Now Update</title><path d="M480-144q-70 0-131.13-26.6-61.14-26.6-106.4-71.87-45.27-45.26-71.87-106.4Q144-410 144-480t26.6-131.13q26.6-61.14 71.87-106.4 45.26-45.27 106.4-71.87Q410-816 480-816q81 0 149.5 35T744-686v-130h72v240H576v-72h107q-35.91-44.8-88.45-70.4Q542-744 480-744q-109 0-186.5 77.5T216-480q0 109 77.5 186.5T480-216q109 0 186.5-77.5T744-480h72q0 140-98 238t-238 98Zm100-200L444-480v-192h72v162l115 115-51 51Z"/></svg>
				<h2><a href="/now"><time datetime="${ item.date_raw }" title="Date of now page update.">${ functions/pretty-date.js(item.date_raw) } UTC</time></a></h2>
			</div>
		</header>

		<div class="readable">
			${ item.overall ? `<p><em>Updated overall:</em> ${ item.overall }</p>` : '' }
			${ item.diff_added?.length > 0 ? `
				<ul>
					${ Tree.map(item.diff_added, (added) => `<li><strong>Added:</strong> ${ added.value }</li>`) }
				</ul>
			` : '' }
			${ item.diff_removed?.length > 0 ? `
				<ul>
					${ Tree.map(item.diff_removed, (removed) => `<li><strong>Removed:</strong> ${ removed.value }</li>`) }
				</ul>
			` : '' }
		</div>
	</article>
`
: `
	<article class="micro">
		<header>
			<div>
				<svg viewBox="0 -960 960 960"><title>Micro</title><path d="M239-192q-91-3-141-40T48-333q0-63 50-101t139-44q35-2 55-12t20-27q0-27-27-40t-96-19l6-72q96 6 143 39t46 92q0 48-37 77t-105 34q-61 5-91 23t-31 50q0 33 29 50t93 19zm322-67L403-418l377-377 158 159zm-35 35-199 41 41-200z"/></svg>
				<h2><a href="/${ Origami.basename(key) }"><time datetime="${ item.pub_time }" title="Date of first publication.">${ functions/pretty-date.js(item.pub_time) }, ${ functions/pretty-time.js(item.pub_time) } UTC</time>${ item.title ? `<p> - ${ item.title }</p>` : '' }</a></h2>
			</div>

			<div class="socials">
				${ item.fedi_link ? `<a href="https://fedi.vale.rocks/notice/${ item.fedi_link }" title="Fediverse">${ (icons.yaml).fediverse }</a>` : '' }
				${ item.bsky_link ? `<a href="https://bsky.app/profile/${ item.bsky_link }" title="Bluesky">${ (icons.yaml).bluesky }</a>` : '' }
				${ item.linkedin_link ? `<a href="https://www.linkedin.com/posts/${ item.linkedin_link }" title="LinkedIn">${ (icons.yaml).linkedin }</a>` : '' }
				${ item.lesswrong_link ? `<a href="https://www.lesswrong.com/posts/${ item.lesswrong_link }" title="LessWrong">${ (icons.yaml).lesswrong }</a>` : '' }
			</div>
		</header>

		<div class="readable">
			${ item._body }
		</div>
	</article>
`
