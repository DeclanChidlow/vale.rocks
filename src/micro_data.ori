functions/validate-schema.js(micro-schema.yaml)(micros)
→ (_) => Tree.map(_, (micro, fileName) => {
	...micro
	type: "micro"
	file_name: Origami.basename(fileName)
	pub_time: functions/micro-date.js(file_name)
})
→ (_) => Tree.mapExtension(_, ".md->.html", {
	value: (micro) => functions/parse-markdown.js(micro)
})
→ (_) => Tree.map(_, (micro) => {
	...micro
	...functions/first-image.js(micro._body)
})
→ Tree.reverse
